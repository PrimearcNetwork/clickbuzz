# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Environment files contain live secrets (DB credentials, JWT secret, Razorpay
# key/secret, Bunny Storage keys) and must never be committed.
.env
.env.*
backend/.env
# Local testing configs (never published) — see CLAUDE.md §0.0
.env.development
backend/.env.development
# ...except the names-only reference file, which should be committed.
!backend/.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code project files — agent configs/local settings, not needed to run the app
.claude/

# AI assistant project memory — not needed to run the app
CLAUDE.md

# Testing — not needed to run the app
/e2e/
/load-tests/
playwright.config.js

# Project readme — not needed to run the app
/README.md

# Leftover local-disk upload artifacts from a removed pre-Bunny-Storage
# upload architecture (see CLAUDE.md §19) — current upload.middleware.js
# streams everything to Bunny Storage and never writes to local disk, so
# nothing under here is referenced by any code path anymore.
backend/uploads/

# MaxMind GeoLite2 database — proprietary/licensed data (redistribution is
# against MaxMind's license), downloaded locally via backend/scripts/downloadGeoDb.js
backend/data/*.mmdb
