# Names only — never real values in this file.
#
# Which file the backend loads (config/loadEnv.js — exactly one, never merged):
#   local (npm run dev/start, migrations, scripts) -> backend/.env.development
#   NODE_ENV=production in the PROCESS env (PM2)    -> backend/.env
#   ENV_FILE=<file> in the process env              -> that file (explicit override)
# A missing file stops startup; there is no fallback to .env. NODE_ENV written
# inside these files does NOT choose the file. Never copy production secrets
# (Razorpay live, Bunny, Meta, postback, prod DB) into .env.development.
# Quote any value containing "#" ('like#this'), or dotenv cuts it off there.
# See CLAUDE.md §0.0.

PORT=5000
# production on the VPS (deploy/ecosystem.config.cjs sets it); development locally.
NODE_ENV=development
# Bind address. Production: 127.0.0.1 (Nginx is the only public entry point).
# Empty = all interfaces (fine for local dev).
BIND_HOST=
# HTTP worker processes forked by server.js (default: CPU count). Production: 6.
WEB_CONCURRENCY=
# Boot-time schema sync: alter | safe | none. Default: safe when
# NODE_ENV=production, alter otherwise. Never alter in production (see server.js).
DB_SYNC_MODE=

# Self-hosted Ubuntu VPS MySQL — see CLAUDE.md §7/§11 (Railway and Aiven are
# no longer used). The dialect is always mysql (fixed in config/db.config.js).
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306
# Optional. If set, it takes precedence over the discrete DB_* vars above
# (format: mysql://USER:PASSWORD@HOST:3306/DB_NAME — URL-encode special chars
# in the password). Make sure it never still points at an old database host.
DATABASE_URL=
# The VPS MySQL listens on plain 3306 without TLS — leave false unless TLS has
# been explicitly configured on the MySQL server (true was only for Aiven).
DB_SSL=false

JWT_SECRET=
JWT_EXPIRES_IN=30d

# Password for the /admin and /analytics dashboards (server-side check only —
# never sent to the browser). Unset = both dashboards stay locked. Changing it
# logs out every open admin session.
ADMIN_ACCESS_PASSWORD=
# How long an admin login lasts (hours).
ADMIN_SESSION_TTL_HOURS=12

# Razorpay (Orders + Checkout.js + Subscriptions — see CLAUDE.md §9)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks > (this webhook)'s own secret — used to
# verify X-Razorpay-Signature on POST /api/payments/webhook.
RAZORPAY_WEBHOOK_SECRET=
# Not read by any code today (kept for reference): https://api.clickbuz.in
BACKEND_URL=
# Extra CORS origin on top of the hardcoded https://clickbuz.in / www (app.js).
FRONTEND_URL=https://clickbuz.in

# ── Meta Conversions API (server-side CompleteRegistration mirror; see CLAUDE.md §24) ──
# Backend's own copy of the Pixel ID — separate from the frontend's
# VITE_META_PIXEL_ID (a Vite build-time var, not accessible to Node). Use the
# same Pixel ID as the frontend.
META_PIXEL_ID=
# Generate at Events Manager > [Your Pixel] > Settings > Conversions API >
# Generate Access Token.
META_CAPI_ACCESS_TOKEN=
# Only for Meta's Test Events tool in Events Manager — leave empty in production.
META_CAPI_TEST_EVENT_CODE=

BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_REGION=
BUNNY_STORAGE_ACCESS_KEY=
BUNNY_CDN_BASE_URL=

MAX_UPLOAD_MB_BANNER=10
MAX_UPLOAD_MB_POSTER=10
MAX_UPLOAD_MB_THUMBNAIL=10
MAX_UPLOAD_MB_SUBTITLE=5
MAX_UPLOAD_MB_MOVIE=20480
MAX_UPLOAD_MB_TRAILER=2048

# Reminder system (RabbitMQ + cron) — see backend/jobs|queues|workers|services
# Production: amqp://clickbuz:<password>@127.0.0.1:5672/clickbuz — written by
# deploy/rabbitmq-setup.sh. Local dev: amqp://localhost:5672 (guest account).
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_RECONNECT_DELAY_MS=5000
REMINDER_QUEUE_NAME=reminder_queue
REMINDER_CRON_SCHEDULE=* * * * *
REMINDER_DAYS_BEFORE=7
REMINDER_MAX_RETRIES=3
REMINDER_RETRY_DELAY_MS=3000

# Recurring/autopay billing (Razorpay Subscriptions) — after this many
# consecutive failed/halted recurring charges (per subscription.charged /
# subscription.halted webhooks, see paymentReconcile.service.js), autopay is
# auto-disabled on our side too.
AUTOPAY_MAX_CONSECUTIVE_FAILURES=3

# ── Website Analytics System (see CLAUDE.md §23) ────────────────────────────
# Salt used to one-way-hash visitor IP addresses before anything ever touches
# the database — raw IPs are never stored. Set this to a long random string
# in production; changing it later just means IP-based dedup/rate-limiting
# resets (no visitor data is lost).
ANALYTICS_IP_HASH_SALT=

# IP Geolocation — MaxMind GeoLite2 City, read from a local .mmdb database
# file for fast/offline lookups (see backend/scripts/downloadGeoDb.js,
# `npm run geo:update` from backend/). Get a free license key from your
# MaxMind account: https://www.maxmind.com/en/accounts/current/license-key
# Leave MAXMIND_LICENSE_KEY empty to disable geolocation enrichment entirely
# (country/region/city/lat/long will just stay null; nothing else breaks).
MAXMIND_LICENSE_KEY=
# Only needed if you want the MaxMind web-service fallback (used when no
# local .mmdb file is present) instead of/alongside the local database.
MAXMIND_ACCOUNT_ID=
MAXMIND_EDITION_ID=GeoLite2-City
MAXMIND_DB_PATH=data/GeoLite2-City.mmdb

# In-process tracking write buffer (backend/services/analytics/eventBuffer.service.js)
ANALYTICS_FLUSH_INTERVAL_MS=3000
ANALYTICS_MAX_BUFFER_SIZE=500

# Per-IP tracking requests allowed per minute before the /api/analytics/collect
# endpoint silently drops further hits (abuse/bot protection).
ANALYTICS_RATE_LIMIT_PER_MINUTE=300

# Nightly job that pre-aggregates analytics_daily_summary for the dashboard's
# trend charts (backend/jobs/analyticsRollup.cron.js). Default: 00:10 daily.
ANALYTICS_ROLLUP_CRON_SCHEDULE=10 0 * * *

# ── Marketing Click ID (see CLAUDE.md §25) ──────────────────────────────────
# ONE stable, integration-level identifier for our marketing/affiliate
# partner — confirmed by the marketing team to be a single ID, generated
# once by us, handed to them, and reused for the life of the integration. It
# is completely independent of this app's per-visitor analytics visitor_id
# (src/analytics/tracker.js) — never derive one from the other.
#
# Generate it once via: node backend/scripts/generateMarketingClickId.js
# (prints a candidate value — does not write this file automatically). Paste
# the printed value below, give the same value to the marketing team, and do
# not change it afterwards; regenerating would break their existing
# tracking/integration setup.
#
# Not currently read by any backend code — there is no confirmed marketing
# postback/API spec yet (endpoint, auth, payload, response are all
# unconfirmed), so nothing here invents one. This var exists purely as the
# one place that value is configured, ready for whenever such an integration
# is specified.
MARKETING_CLICK_ID=

# ── Affiliate Partner S2S Postback — TrafficMedia24 (see CLAUDE.md §26) ────
# Distinct from MARKETING_CLICK_ID above: this is TrafficMedia24's confirmed
# conversion postback endpoint, called once per successful payment for a
# visitor who arrived with a per-click ?click_id=... URL param (captured
# client-side in src/analytics/affiliateClickId.js, sent to the backend at
# checkout, stored on Payment.click_id). AFFILIATE_POSTBACK_URL is the
# partner's callback base URL (no query string) and AFFILIATE_POSTBACK_ID the
# fixed `id` param it requires; the app sends GET <URL>?click=<click_id>&id=<ID>.
# Real values are kept only in the server's backend/.env, not in this file.
AFFILIATE_POSTBACK_URL=
AFFILIATE_POSTBACK_ID=
# Per-plan override, keyed by the paid plan's billing_cycle: a successful
# WEEKLY (₹99) payment reports to media9 instead of the default above.
# Any cycle without its own URL (e.g. MONTHLY) keeps using the default.
AFFILIATE_POSTBACK_URL_WEEKLY=
AFFILIATE_POSTBACK_ID_WEEKLY=
